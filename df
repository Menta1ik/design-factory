#!/usr/bin/env node

/**
 * Design Factory CLI (df)
 * Orchestrates the AI design pipeline: Extraction -> Tokenization -> PDF Rendering.
 * Zero external dependencies. Works out of the box on macOS, Linux, and Windows.
 */

const fs = require('fs');
const path = require('path');
const { execSync, spawn } = require('child_process');
const readline = require('readline');

const VERSION = '1.0.0';

// Colors for terminal output
const colors = {
  reset: '\x1b[0m',
  bright: '\x1b[1m',
  green: '\x1b[32m',
  blue: '\x1b[34m',
  cyan: '\x1b[36m',
  yellow: '\x1b[33m',
  red: '\x1b[31m',
};

function log(color, msg) {
  console.log(`${color}${msg}${colors.reset}`);
}

function printHeader() {
  console.log(`\n${colors.bright}${colors.cyan}===============================================`);
  console.log(`   DESIGN FACTORY CLI (df) · v${VERSION}   `);
  console.log(`===============================================${colors.reset}\n`);
}

function showHelp() {
  printHeader();
  console.log('Usage: ./df <command> [args]\n');
  console.log('Commands:');
  console.log('  install            Install all design pipeline tools and register skills globally.');
  console.log('  extract <URL>      Extract raw design tokens and assets from a brand website.');
  console.log('  make-ds <brand>    Initialize a new design system structure locally.');
  console.log('  compile            Compile rules files (.cursorrules, .clinerules, instructions.md).');
  console.log('  console            Launch the local Web Console (Design Factory Console).');
  console.log('  version            Print the current version.');
  console.log('  help               Show this help message.\n');
}

// Ensure execution within the repo root
const repoRoot = __dirname;

// COMMAND: extract
function handleExtract(url) {
  if (!url) {
    log(colors.red, 'Error: Target URL is required.');
    console.log('Usage: ./df extract <URL>');
    process.exit(1);
  }

  printHeader();
  log(colors.blue, `[*] Starting brand extraction pipeline for: ${url}`);

  // Create clean brand slug
  let slug = url
    .replace(/^https?:\/\//i, '')
    .replace(/^www\./i, '')
    .split('/')[0]
    .replace(/\.[a-z]{2,}$/i, '')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '-');

  log(colors.cyan, `[*] Brand Slug resolved: ${slug}`);

  // Create folders
  const outputDir = path.join(repoRoot, 'source-raw', slug);
  const monolithDir = path.join(outputDir, 'monolith');
  const mirrorDir = path.join(outputDir, 'mirror');
  const designlangDir = path.join(outputDir, 'designlang');

  fs.mkdirSync(monolithDir, { recursive: true });
  fs.mkdirSync(mirrorDir, { recursive: true });
  fs.mkdirSync(designlangDir, { recursive: true });

  log(colors.green, `[✓] Directory structure created at: source-raw/${slug}`);

  // Step 1: Pre-warm Chromium
  log(colors.blue, '[*] Pre-warming Playwright Chromium...');
  try {
    execSync('npx -y playwright install chromium', { stdio: 'ignore' });
    log(colors.green, '[✓] Playwright Chromium warmed up.');
  } catch (err) {
    log(colors.yellow, '[!] Playwright install warning (continuing...).');
  }

  // Step 2a: Run Monolith
  log(colors.blue, '\n[*] Running monolith (Single-file offline capture)...');
  try {
    execSync(`monolith "${url}" -o "${path.join(monolithDir, 'site.html')}" --timeout 120`, { stdio: 'inherit' });
    log(colors.green, '[✓] Monolith download completed successfully.');
  } catch (err) {
    log(colors.red, '[✗] Monolith download failed. Continuing with fallback.');
  }

  // Step 2b: Run Wget
  log(colors.blue, '\n[*] Running wget mirror (Structured assets capture)...');
  try {
    const wgetCmd = `wget --mirror --convert-links --adjust-extension --page-requisites --no-parent --restrict-file-names=windows --level=1 --timeout=30 --tries=2 -P "${mirrorDir}" "${url}"`;
    execSync(wgetCmd, { stdio: 'inherit' });
    log(colors.green, '[✓] Wget mirror completed successfully.');
  } catch (err) {
    log(colors.yellow, '[!] Wget mirror finished with some errors (continuing).');
  }

  // Step 2c: Run Designlang
  log(colors.blue, '\n[*] Running designlang (Token & PDF Brand Book extraction)...');
  try {
    const dlCmd = `npx -y designlang "${url}" --full --pdf --platforms all --out "${designlangDir}"`;
    execSync(dlCmd, { stdio: 'inherit' });
    log(colors.green, '[✓] Designlang token extraction completed successfully.');
  } catch (err) {
    log(colors.yellow, '[!] Designlang failed on full run. Attempting lightweight PDF render...');
    try {
      execSync(`npx -y designlang "${url}" --pdf --out "${designlangDir}"`, { stdio: 'inherit' });
      log(colors.green, '[✓] Designlang lightweight PDF completed.');
    } catch (e) {
      log(colors.red, '[✗] Designlang token extraction completely failed.');
    }
  }

  log(colors.bright + colors.green, '\n===============================================');
  log(colors.bright + colors.green, '✓ BRAND EXTRACTION COMPLETE!');
  log(colors.bright + colors.green, '===============================================');
  console.log(`\nRaw brand assets saved to: source-raw/${slug}`);
  console.log('\nNext Steps:');
  console.log(`  1. Run "./df make-ds ${slug}" to initialize the design system bundle.`);
  console.log(`  2. Invoke Claude Code and type "/create-design-system" inside the workspace.`);
}

// COMMAND: make-ds
function handleMakeDs(brand) {
  if (!brand) {
    log(colors.red, 'Error: Brand slug is required.');
    console.log('Usage: ./df make-ds <brand-slug>');
    process.exit(1);
  }

  printHeader();
  const dsDir = path.join(repoRoot, `${brand}-design-system`);
  log(colors.blue, `[*] Initializing Design System folder: ${brand}-design-system`);

  fs.mkdirSync(dsDir, { recursive: true });
  fs.mkdirSync(path.join(dsDir, 'preview'), { recursive: true });
  fs.mkdirSync(path.join(dsDir, 'ui_kits'), { recursive: true });
  fs.mkdirSync(path.join(dsDir, 'assets'), { recursive: true });
  fs.mkdirSync(path.join(dsDir, 'fonts'), { recursive: true });
  fs.mkdirSync(path.join(dsDir, 'slides'), { recursive: true });

  // Create initial cards.json skeleton
  const cardsJson = {
    brandName: brand.charAt(0).toUpperCase() + brand.slice(1),
    generatedAt: new Date().toISOString(),
    cards: []
  };
  fs.writeFileSync(path.join(dsDir, 'cards.json'), JSON.stringify(cardsJson, null, 2));

  // Initialize a placeholder colors_and_type.css
  const placeholderCss = `/**\n * Design System Tokens: ${brand}\n * Generated via Design Factory CLI\n */\n\n:root {\n  /* Colors */\n  --${brand}-primary: #0A0A0A;\n  --${brand}-secondary: #FAF9F6;\n  --${brand}-accent: #002FA7;\n\n  /* Typography */\n  --${brand}-font-display: 'Inter Tight', sans-serif;\n  --${brand}-font-body: 'Inter', sans-serif;\n}\n`;
  fs.writeFileSync(path.join(dsDir, 'colors_and_type.css'), placeholderCss);

  log(colors.green, `[✓] Folders and base assets successfully created in: ${brand}-design-system`);
  log(colors.green, '\n[!] Run "./df compile" inside the project to generate IDE helper rules!');
}

// COMMAND: compile
function handleCompile() {
  printHeader();
  log(colors.blue, '[*] Generating IDE helper rule files (.cursorrules, .clinerules, instructions.md)...');

  const rulesContent = `# DESIGN FACTORY · AI AGENT RULES

This project uses the Design Factory system for advanced, high-fidelity AI-assisted UI/UX engineering.

## ⛔ CRITICAL RULE: FENCE AGAINST "AI SLOP"
Do not generate generic, cookie-cutter artificial interfaces. Follow these constraints:
1. **NO SaaS Blue-to-Purple-to-Pink Glows:** Do not inject neon radial glowing gradient backgrounds unless specifically present in the brand materials.
2. **NO Arial/Inter Defaults:** Never default to generic Arial or Inter fonts for display/headline typography. Use distinctive, characterful typography pairings.
3. **NO Rounded Border-Left Alert Cards:** Avoid the standard LLM card aesthetic (\`.rounded-lg\` with \`border-l-4 border-indigo-500\`).
4. **NO Hand-drawn SVGs:** Use clean CDN libraries (Lucide, Heroicons) or exact vector values from source. Never code "approximate" shapes.

## 🎨 10 PREMIUM VISUAL STYLES
When editing CSS or HTML templates, align with one of these visual themes:
- **Neubrutalism:** Solid thick borders (\`2px solid #000\`), hard flat primary colors (\`#FFF\`, \`#FACC15\`), offset shadows (\`box-shadow: 4px 4px 0px #000\`), zero gradients.
- **Glassmorphism:** Semi-transparent backdrops (\`rgba(255,255,255,0.05)\`), thick blur filters (\`backdrop-filter: blur(12px)\`), glowing accents.
- **Bento Grid:** Asymmetrical multi-span layouts (\`col-span-2\`, \`row-span-2\`), uniform spacing (\`24px\`), generous rounded corners (\`16-24px\`).
- **Warm Editorial:** Cream paper backgrounds (\`#FAF9F6\`), high-contrast elegant serif headings, light grey hairline borders, spacious margins.
- **Sleek Cyber Tech:** True dark backgrounds (\`#090E17\`), razor-thin borders, sharp neon coordinates, monospaced labels.

## 🔤 SIGNATURE GOOGLE FONTS PAIRINGS
Select distinctive font pairs based on brand personality:
- **Luxury / Wellness:** Cormorant Garamond + Montserrat / Fraunces + Plus Jakarta Sans
- **SaaS / Technology:** Space Grotesk + Plus Jakarta Sans / Outfit + JetBrains Mono
- **Editorial / News:** DM Serif Display + DM Sans / Newsreader + Plus Jakarta Sans
- **Utilitarian / Modern:** Archivo Black + Archivo / Space Mono + Space Grotesk

## 🛠️ CLI TOOL INTEGRATIONS
Always use these tools instead of manually parsing or editing:
- Run \`./df extract <URL>\` to scrape raw brand styles.
- Run \`./df make-ds <brand>\` to configure folders.
- Use \`/render-brand-pdf\` to compile high-fidelity presentations.
`;

  // Write .cursorrules
  fs.writeFileSync(path.join(repoRoot, '.cursorrules'), rulesContent);
  log(colors.green, '[✓] .cursorrules written successfully.');

  // Write .clinerules
  fs.writeFileSync(path.join(repoRoot, '.clinerules'), rulesContent);
  log(colors.green, '[✓] .clinerules written successfully.');

  // Write .windsurfrules
  fs.writeFileSync(path.join(repoRoot, '.windsurfrules'), rulesContent);
  log(colors.green, '[✓] .windsurfrules written successfully.');

  // Write instructions.md (standard markdown for OpenAI Codex / Continue)
  fs.writeFileSync(path.join(repoRoot, 'instructions.md'), rulesContent);
  log(colors.green, '[✓] instructions.md written successfully.');

  log(colors.bright + colors.green, '\n[✓] ALL IDE RULES SUCCESSFULLY COMPILED!');
  console.log('\nAI agents in Cursor, Windsurf, Roo Cline, and OpenAI Codex will now automatically detect your design principles.');
}

// COMMAND: console
function handleConsole() {
  printHeader();
  log(colors.blue, '[*] Starting Design Factory Console local server...');
  
  const serverPath = path.join(repoRoot, 'console', 'server.js');
  if (!fs.existsSync(serverPath)) {
    log(colors.red, `Error: Web console server script not found at ${serverPath}.`);
    console.log('Please make sure you have fully completed Phase 4 of the roadmap.');
    process.exit(1);
  }

  // Start the server in the background and pipe output
  const serverProcess = spawn('node', [serverPath], { cwd: repoRoot, stdio: 'inherit' });
  
  serverProcess.on('error', (err) => {
    log(colors.red, `Failed to launch console: ${err.message}`);
  });
}

// COMMAND: install
function handleInstall() {
  printHeader();
  const platform = process.platform;
  log(colors.blue, `[*] Starting cross-platform environment setup on: ${platform}`);

  const userHome = process.env.HOME || process.env.USERPROFILE;
  const skillsDest = path.join(userHome, '.claude', 'skills');
  const workspaceDir = path.join(userHome, 'Design System');

  // Create skills and workspace folders
  fs.mkdirSync(skillsDest, { recursive: true });
  fs.mkdirSync(workspaceDir, { recursive: true });
  log(colors.green, `[✓] Prepared global directories under: ${userHome}`);

  // Register skills by copying from repo
  const repoSkillsDir = path.join(repoRoot, 'skills');
  if (fs.existsSync(repoSkillsDir)) {
    const copyRecursiveSync = (src, dest) => {
      const exists = fs.existsSync(src);
      const stats = exists && fs.statSync(src);
      const isDirectory = exists && stats.isDirectory();
      if (isDirectory) {
        fs.mkdirSync(dest, { recursive: true });
        fs.readdirSync(src).forEach((childItemName) => {
          copyRecursiveSync(path.join(src, childItemName), path.join(dest, childItemName));
        });
      } else {
        fs.copyFileSync(src, dest);
      }
    };

    try {
      // Remove old copies if any to ensure fresh registration
      const rmdir = (dir) => {
        if (fs.existsSync(dir)) {
          fs.rmSync(dir, { recursive: true, force: true });
        }
      };
      rmdir(path.join(skillsDest, 'extract-brand-assets'));
      rmdir(path.join(skillsDest, 'create-design-system'));
      rmdir(path.join(skillsDest, 'render-brand-pdf'));

      copyRecursiveSync(path.join(repoSkillsDir, 'extract-brand-assets'), path.join(skillsDest, 'extract-brand-assets'));
      copyRecursiveSync(path.join(repoSkillsDir, 'create-design-system'), path.join(skillsDest, 'create-design-system'));
      copyRecursiveSync(path.join(repoSkillsDir, 'render-brand-pdf'), path.join(skillsDest, 'render-brand-pdf'));
      log(colors.green, `[✓] Registered AI skills globally in: ${skillsDest}`);
    } catch (err) {
      log(colors.red, `[✗] Error copying skills: ${err.message}`);
    }
  }

  // OS Specific dependencies
  if (platform === 'darwin') {
    log(colors.blue, '[*] Installing brew dependencies (monolith, wget)...');
    try {
      execSync('brew install monolith wget', { stdio: 'inherit' });
      log(colors.green, '[✓] Homebrew dependencies successfully configured.');
    } catch (err) {
      log(colors.yellow, '[!] Brew error, please make sure Homebrew is installed.');
    }
  } else if (platform === 'win32') {
    log(colors.blue, '[*] Installing winget dependencies (monolith, wget)...');
    try {
      execSync('winget install --id JernejSimoncic.Wget -e --silent --accept-package-agreements --accept-source-agreements', { stdio: 'inherit' });
      execSync('winget install --id Y2Z.Monolith -e --silent --accept-package-agreements --accept-source-agreements', { stdio: 'inherit' });
      log(colors.green, '[✓] Windows dependencies successfully configured.');
    } catch (err) {
      log(colors.yellow, '[!] Winget error, please make sure you have winget package manager.');
    }
  }

  // Install Claude Code CLI
  log(colors.blue, '[*] Installing Claude Code CLI globally...');
  try {
    execSync('npm install -g @anthropic-ai/claude-code', { stdio: 'inherit' });
    log(colors.green, '[✓] Claude Code successfully installed globally.');
  } catch (err) {
    log(colors.yellow, '[!] npm install warning. If it is a permission issue, run with local prefix.');
  }

  log(colors.bright + colors.green, '\n===============================================');
  log(colors.bright + colors.green, '✓ ENVIRONMENT SETUP SUCCESSFULLY COMPLETED!');
  log(colors.bright + colors.green, '===============================================');
  console.log(`\nWorkspace: ${workspaceDir}`);
  console.log(`Skills folder: ${skillsDest}`);
}

// Main router
const args = process.argv.slice(2);
const command = args[0];

if (!command) {
  showHelp();
  process.exit(0);
}

switch (command.toLowerCase()) {
  case 'install':
    handleInstall();
    break;
  case 'extract':
    handleExtract(args[1]);
    break;
  case 'make-ds':
    handleMakeDs(args[1]);
    break;
  case 'compile':
    handleCompile();
    break;
  case 'console':
    handleConsole();
    break;
  case 'version':
    console.log(`v${VERSION}`);
    break;
  case 'help':
  default:
    showHelp();
    break;
}
