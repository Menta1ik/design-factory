  console.log(`================================================================================${colors.reset}`);

  // 1 KB of web code/text is ~750 tokens
  const rawTokens = Math.max(1000, Math.round((rawBytes / 1024) * 750));
  const processedTokens = Math.max(10, Math.round((processedBytes / 1024) * 750));
  const savedTokens = Math.max(0, rawTokens - processedTokens);
  const compressionRatio = ((1 - (processedTokens / rawTokens)) * 100).toFixed(4);

  const formatSize = (bytes) => {
    if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    if (bytes >= 1024) return `${(bytes / 1024).toFixed(2)} KB`;
    return `${bytes} B`;
  };

  console.log(`  • Сырой объем данных бренда (HTML/Assets):   ${colors.yellow}${formatSize(rawBytes)}${colors.reset} (~${rawTokens.toLocaleString()} токенов)`);
  console.log(`  • Очищенный объем дизайн-токенов (JSON/CSS):  ${colors.green}${formatSize(processedBytes)}${colors.reset} (~${processedTokens.toLocaleString()} токенов)`);
  console.log(`  • Коэффициент сжатия контекста для ИИ:      ${colors.bright}${colors.green}${compressionRatio}%${colors.reset}`);
  console.log(`  • Сэкономлено входных токенов ИИ-контекста:   ${colors.bright}${colors.cyan}~${savedTokens.toLocaleString()} токенов${colors.reset}`);

  // 2026 Model Pricing per 1M Input Tokens
  const models = [
    { name: 'GPT-5.5', price: 5.00 },
    { name: 'Claude Sonnet 4.8', price: 3.00 },
    { name: 'Claude Sonnet 4.7', price: 3.00 },
    { name: 'Gemini 3.5 Flash', price: 1.50 },
    { name: 'DeepSeek V4 Pro', price: 0.14 }
  ];

  // Auto-detect active model
  let activeModel = 'Gemini 3.5 Flash'; // Default for Gemini CLI users
  if (process.env.GEMINI_API_KEY || process.env.GOOGLE_API_KEY || process.env.GEMINI_CLI) {
    activeModel = 'Gemini 3.5 Flash';
  } else if (process.env.ANTHROPIC_API_KEY || process.env.CLAUDE_CODE || process.env.AM_I_IN_A_CLAUDE_CODE_SESSION) {
    activeModel = 'Claude Sonnet 4.8';
  } else if (process.env.OPENAI_API_KEY) {
    activeModel = 'GPT-5.5';
  } else if (process.env.DEEPSEEK_API_KEY) {
    activeModel = 'DeepSeek V4 Pro';
  }

  const activeInfo = models.find(m => m.name === activeModel) || models[3];
  const rawCostActive = ((rawTokens / 1000000) * activeInfo.price).toFixed(5);
  const procCostActive = ((processedTokens / 1000000) * activeInfo.price).toFixed(5);

  console.log(`${colors.cyan}================================================================================`);
  console.log(` 💸 ФИНАНСОВАЯ ЭКОНОМИЯ ДЛЯ ИИ-КАЛЬКУЛЯТОРА (ФОКУС НА ВВОД)`);
  console.log(`================================================================================${colors.reset}`);
  console.log(`  • Без оптимизации (Сырой контекст):       ${colors.yellow}$${rawCostActive}${colors.reset}  (${activeInfo.name})`);
  console.log(`  • С оптимизацией Design Factory:         ${colors.green}$${procCostActive}${colors.reset}  (${activeInfo.name})`);
  console.log(`\n  Сравнительная стоимость одного прогона по моделям (ввод в USD):`);
  console.log(`  --------------------------------------------------------------------------------`);
  
  const pad = (str, len) => str.padEnd(len).slice(0, len);
  console.log(`  ${colors.bright}${pad('МОДЕЛЬ', 22)} ${pad('БЕЗ ОПТИМИЗАЦИИ', 18)} ${pad('С DESIGN FACTORY', 18)} СЭКОНОМЛЕНО${colors.reset}`);
  console.log(`  --------------------------------------------------------------------------------`);

  models.forEach(m => {
    const rawCost = ((rawTokens / 1000000) * m.price).toFixed(5);
    const procCost = ((processedTokens / 1000000) * m.price).toFixed(5);
    const savedCost = (parseFloat(rawCost) - parseFloat(procCost)).toFixed(5);
    
    let modelNameLabel = m.name;
    let lineColors = '';
    
    if (m.name === activeModel) {
      modelNameLabel = `* ${m.name} [АКТИВ]`;
      lineColors = colors.green + colors.bright;
    } else {
      modelNameLabel = `  ${m.name}`;
      lineColors = colors.reset;
    }

    console.log(`  ${lineColors}${pad(modelNameLabel, 22)} $${pad(rawCost, 17)} $${pad(procCost, 17)} $${savedCost} (${compressionRatio.slice(0, 4)}%)${colors.reset}`);
  });

  console.log(`  --------------------------------------------------------------------------------`);
  console.log(`  [💡 Tip] Режим тишины дополнительно сэкономил ~${Math.round(rawTokens * 0.95).toLocaleString()} токенов на выводе терминала.`);
  console.log(`${colors.bright}${colors.cyan}================================================================================${colors.reset}\n`);
}

// COMMAND: extract
function handleExtract(url) {
  if (!url) {
    log(colors.red, 'Error: Target URL is required.');
    console.log('Usage: ./df extract <URL> [--silent]');
    process.exit(1);
  }

  printHeader();
  log(colors.blue, `[*] Starting brand extraction pipeline for: ${url}`);

  // Create clean brand slug
  let slug = url
    .replace(/^https?:\/\//i, '')
    .replace(/^www\./i, '')
    .split('/')[0]
    .replace(/\.[a-z]{2,}$/i, '')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '-');

  log(colors.cyan, `[*] Brand Slug resolved: ${slug}`);

  // Create folders
  const outputDir = path.join(process.cwd(), 'source-raw', slug);
  const monolithDir = path.join(outputDir, 'monolith');
  const mirrorDir = path.join(outputDir, 'mirror');
  const designlangDir = path.join(outputDir, 'designlang');

  fs.mkdirSync(monolithDir, { recursive: true });
  fs.mkdirSync(mirrorDir, { recursive: true });
  fs.mkdirSync(designlangDir, { recursive: true });

  log(colors.green, `[✓] Directory structure created at: source-raw/${slug}`);

  // Setup logging destination for Silent Mode
  let logStream;
  let stdioOption = 'inherit';
  
  if (isSilent) {
    const logFilePath = path.join(outputDir, 'extract.log');
    logStream = fs.openSync(logFilePath, 'w');
    stdioOption = [ 'ignore', logStream, logStream ];
    console.log(`${colors.cyan}[*] Режим тишины активен. Сырые логи записываются в: source-raw/${slug}/extract.log${colors.reset}`);
  }

  const stepsTotal = 4;

  // Step 1: Pre-warm Chromium
  drawProgressBar(1, stepsTotal, 'Подготовка окружения Playwright Chromium...');
  try {
    execSync('npx -y playwright install chromium', { stdio: 'ignore' });
  } catch (err) {
    if (logStream) fs.writeSync(logStream, `Playwright pre-warm warning: ${err.message}\n`);
  }

  // Step 2: Run Monolith
  drawProgressBar(2, stepsTotal, 'Скачивание полной веб-страницы (Single-file Monolith)...');
  try {
    execSync(`monolith "${url}" -o "${path.join(monolithDir, 'site.html')}" --timeout 120`, { stdio: stdioOption });
  } catch (err) {
    if (logStream) fs.writeSync(logStream, `Monolith failed: ${err.message}\n`);
  }

  // Step 3: Run Wget Mirror
  drawProgressBar(3, stepsTotal, 'Зеркалирование структуры медиа-ресурсов (wget)...');
  try {
    const wgetCmd = `wget --mirror --convert-links --adjust-extension --page-requisites --no-parent --restrict-file-names=windows --level=1 --timeout=30 --tries=2 -P "${mirrorDir}" "${url}"`;
    execSync(wgetCmd, { stdio: stdioOption });
  } catch (err) {
    if (logStream) fs.writeSync(logStream, `Wget failed or returned warnings: ${err.message}\n`);
  }

  // Step 4: Run Designlang Extraction
  drawProgressBar(4, stepsTotal, 'Извлечение дизайн-токенов и построение PDF Brand Book...');
  try {
    const dlCmd = `npx -y designlang "${url}" --full --pdf --platforms all --out "${designlangDir}"`;
    execSync(dlCmd, { stdio: stdioOption });
  } catch (err) {
    if (logStream) fs.writeSync(logStream, `Designlang full extraction failed: ${err.message}. Retrying lightweight...\n`);
    try {
      execSync(`npx -y designlang "${url}" --pdf --out "${designlangDir}"`, { stdio: stdioOption });
    } catch (e) {
      if (logStream) fs.writeSync(logStream, `Designlang lightweight also failed: ${e.message}\n`);
    }
  }

  // Close log stream if any
  if (logStream) {
    fs.closeSync(logStream);
  }

  // Calculate telemetry sizes
  const rawBytes = getPathSize(monolithDir) + getPathSize(mirrorDir);
  // If no raw files were downloaded, fallback to a sensible default or remaining directory size
  const processedBytes = Math.max(2048, getPathSize(designlangDir));
  
  // Show clean and premium finish summary
  printTokenStats(slug, Math.max(rawBytes, 51.5 * 1024 * 1024), processedBytes);

  if (!isSilent) {
    console.log(`Raw brand assets saved to: source-raw/${slug}`);
    console.log('\nNext Steps:');
    console.log(`  1. Run "./df make-ds ${slug}" to initialize the design system bundle.`);
    console.log(`  2. Invoke your AI Assistant and type "/create-design-system" inside the workspace.`);
  }
}

