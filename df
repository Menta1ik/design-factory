      rmdir(path.join(skillsDest, 'render-brand-pdf'));

      copyRecursiveSync(path.join(repoSkillsDir, 'extract-brand-assets'), path.join(skillsDest, 'extract-brand-assets'));
      copyRecursiveSync(path.join(repoSkillsDir, 'create-design-system'), path.join(skillsDest, 'create-design-system'));
      copyRecursiveSync(path.join(repoSkillsDir, 'render-brand-pdf'), path.join(skillsDest, 'render-brand-pdf'));
      log(colors.green, `[✓] Registered AI skills globally in: ${skillsDest}`);
    } catch (err) {
      log(colors.red, `[✗] Error copying skills: ${err.message}`);
    }
  }

  // OS Specific dependencies
  if (platform === 'darwin') {
    log(colors.blue, '[*] Installing brew dependencies (monolith, wget)...');
    try {
      execSync('brew install monolith wget', { stdio: 'inherit' });
      log(colors.green, '[✓] Homebrew dependencies successfully configured.');
    } catch (err) {
      log(colors.yellow, '[!] Brew error, please make sure Homebrew is installed.');
    }
  } else if (platform === 'win32') {
    log(colors.blue, '[*] Installing winget dependencies (monolith, wget)...');
    try {
      execSync('winget install --id JernejSimoncic.Wget -e --silent --accept-package-agreements --accept-source-agreements', { stdio: 'inherit' });
      execSync('winget install --id Y2Z.Monolith -e --silent --accept-package-agreements --accept-source-agreements', { stdio: 'inherit' });
      log(colors.green, '[✓] Windows dependencies successfully configured.');
    } catch (err) {
      log(colors.yellow, '[!] Winget error, please make sure you have winget package manager.');
    }
  }

  // Install Claude Code CLI
  log(colors.blue, '[*] Installing Claude Code CLI globally...');
  try {
    execSync('npm install -g @anthropic-ai/claude-code', { stdio: 'inherit' });
    log(colors.green, '[✓] Claude Code successfully installed globally.');
  } catch (err) {
    log(colors.yellow, '[!] npm install warning. If it is a permission issue, run with local prefix.');
  }

  log(colors.bright + colors.green, '\n===============================================');
  log(colors.bright + colors.green, '✓ ENVIRONMENT SETUP SUCCESSFULLY COMPLETED!');
  log(colors.bright + colors.green, '===============================================');
  console.log(`\nWorkspace: ${workspaceDir}`);
  console.log(`Skills folder: ${skillsDest}`);
}

// COMMAND: check (Doctor)
function handleCheck() {
  if (isSilent) return;
  printHeader();
  log(colors.blue, '[*] Running system diagnostics & dependencies check...\n');

  const dependencies = [
    { name: 'node', desc: 'Node.js Runtime (>=20.0.0)', cmd: 'node -v', optional: false, installMac: 'brew install node', installWin: 'winget install OpenJS.NodeJS' },
    { name: 'git', desc: 'Git Version Control', cmd: 'git --version', optional: false, installMac: 'xcode-select --install', installWin: 'winget install Git.Git' },
    { name: 'monolith', desc: 'Monolith (Offline saver)', cmd: 'monolith --version', optional: false, installMac: 'brew install monolith', installWin: 'winget install Y2Z.Monolith' },
    { name: 'wget', desc: 'GNU Wget (Scraper)', cmd: 'wget --version', optional: false, installMac: 'brew install wget', installWin: 'winget install JernejSimoncic.Wget' },
    { name: 'claude', desc: 'Claude Code CLI Agent', cmd: 'claude --version', optional: true, installMac: 'npm install -g @anthropic-ai/claude-code', installWin: 'npm install -g @anthropic-ai/claude-code' }
  ];

  let errors = 0;

  // Manual column padding helper to avoid printf/util dependency
  const pad = (str, len) => str.padEnd(len).slice(0, len);

  console.log(`${colors.bright}${pad('TOOL', 12)} ${pad('DESCRIPTION', 28)} ${pad('STATUS', 10)} VERSION / ADVICE${colors.reset}`);
  console.log('--------------------------------------------------------------------------------');

  dependencies.forEach(dep => {
    let status = `${colors.green}[✓] OK${colors.reset}`;
    let version = '';
    
    try {
      version = execSync(dep.cmd, { encoding: 'utf8', stdio: 'pipe' }).trim().split('\n')[0];
    } catch (err) {
      if (dep.optional) {
        status = `${colors.yellow}[!] WARN${colors.reset}`;
        version = `Not installed (optional).`;
      } else {
        status = `${colors.red}[✗] FAIL${colors.reset}`;
        version = `Missing! Install: ${process.platform === 'win32' ? dep.installWin : dep.installMac}`;
        errors++;
      }
    }
    
    console.log(`${pad(dep.name, 12)} ${pad(dep.desc, 28)} ${pad(status, 20)} ${version}`);
  });

  console.log('--------------------------------------------------------------------------------');
  
  if (errors > 0) {
    log(colors.red, `\n[✗] Diagnostics finished with ${errors} critical errors! Please run "./df install" or install manually.`);
  } else {
    log(colors.green, '\n[✓] All dependencies are satisfied! Design Factory is fully operational.');
  }
}


function startWizard() {
  printHeader();
  log(colors.bright + colors.green, '👋 Добро пожаловать в пошаговый мастер Design Factory!');
  console.log('Этот интерактивный помощник настроит ваше окружение и поможет запустить пайплайн.');
  console.log('--------------------------------------------------------------------------------\n');

  // Шаг 1: Быстрая диагностика ядра системы
  const dependencies = [
    { name: 'node', cmd: 'node -v' },
    { name: 'git', cmd: 'git --version' },
    { name: 'monolith', cmd: 'monolith --version' },
    { name: 'wget', cmd: 'wget --version' }
  ];
  
  let missingDeps = [];
  dependencies.forEach(dep => {
    try {
      execSync(dep.cmd, { stdio: 'pipe' });
    } catch (e) {
      missingDeps.push(dep.name);
    }
  });

  if (missingDeps.length > 0) {
    log(colors.yellow, `[!] Обнаружены отсутствующие системные компоненты: ${missingDeps.join(', ')}`);
    const rl = readline.createInterface({
      input: process.stdin,
      output: process.stdout
    });
    rl.question(`\nХотите автоматически установить недостающие утилиты и настроить окружение? (Y/n): `, (answer) => {
      const choice = answer.trim().toLowerCase();
      rl.close();
      if (choice === '' || choice === 'y' || choice === 'yes') {
        handleInstall();
        showMainMenu();
      } else {
        log(colors.yellow, '[!] Автоматическая установка пропущена.');
        showMainMenu();
      }
    });
  } else {
    log(colors.green, '[✓] Отлично! Все ключевые системные зависимости уже установлены и готовы к работе.');
    showMainMenu();
  }
}

function showMainMenu() {
  console.log(`\n${colors.bright}${colors.cyan}--- ГЛАВНОЕ МЕНЮ DESIGN FACTORY ---${colors.reset}\n`);
  console.log('Выберите действие, введя соответствующую цифру:\n');
  console.log(`  ${colors.bright}1)${colors.reset} ${colors.green}[Диагностика]${colors.reset} Проверить готовность системы (Doctor)`);
  console.log(`  ${colors.bright}2)${colors.reset} ${colors.green}[Установка]${colors.reset} Принудительно обновить утилиты и зарегистрировать ИИ-навыки`);
  console.log(`  ${colors.bright}3)${colors.reset} ${colors.green}[Парсинг сайта]${colors.reset} Собрать сырые дизайн-токены и ресурсы с сайта бренда (Extract)`);
  console.log(`  ${colors.bright}4)${colors.reset} ${colors.green}[Создать ДС]${colors.reset} Создать структуру новой дизайн-системы для бренда`);
  console.log(`  ${colors.bright}5)${colors.reset} ${colors.green}[Правила IDE]${colors.reset} Скомпилировать правила для ИИ-агентов (.cursorrules и др.)`);
  console.log(`  ${colors.bright}6)${colors.reset} Выйти`);

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  rl.question(`\nВыберите пункт (1-6): `, (answer) => {
    rl.close();
    const choice = answer.trim();
    switch (choice) {
      case '1':
        handleCheck();
        showMainMenu();
        break;
      case '2':
        handleInstall();
        showMainMenu();
        break;
      case '3': {
        const rlExtract = readline.createInterface({
          input: process.stdin,
          output: process.stdout
        });
        rlExtract.question(`\nВведите URL сайта бренда (например, https://stripe.com): `, (url) => {
          const targetUrl = url.trim();
          if (!targetUrl) {
            log(colors.red, '[✗] URL не может быть пустым.');
            rlExtract.close();
            showMainMenu();
            return;
          }
          
          rlExtract.question(`Включить тихий режим (Silent Mode) для экономии ИИ-токенов? (Y/n): `, (silentAns) => {
            const useSilent = silentAns.trim().toLowerCase() !== 'n';
            rlExtract.close();
            
            const oldSilent = isSilent;
            if (useSilent) {
              isSilent = true;
            }
            
            try {
              handleExtract(targetUrl);
            } catch (err) {
              log(colors.red, `[✗] Произошла ошибка во время извлечения: ${err.message}`);
            }
            
            isSilent = oldSilent;
            
            const slug = targetUrl
              .replace(/^https?:\/\//i, '')
              .replace(/^www\./i, '')
              .split('/')[0]
              .replace(/\.[a-z]{2,}$/i, '')
              .toLowerCase()
              .replace(/[^a-z0-9]/g, '-');
              
            const rlNext = readline.createInterface({
              input: process.stdin,
              output: process.stdout
            });
            
            rlNext.question(`\n[▶] Шаг 2/3: Инициализировать папку дизайн-системы ${colors.bright}${slug}-design-system${colors.reset}? (Y/n): `, (dsAns) => {
              if (dsAns.trim().toLowerCase() !== 'n') {
                try {
                  handleMakeDs(slug);
                } catch (err) {
                  log(colors.red, `[✗] Ошибка создания дизайн-системы: ${err.message}`);
                }
                
                rlNext.question(`\n[▶] Шаг 3/3: Скомпилировать правила IDE (.cursorrules, .clinerules, instructions.md)? (Y/n): `, (rulesAns) => {
                  rlNext.close();
                  if (rulesAns.trim().toLowerCase() !== 'n') {
                    try {
                      handleCompile();
                    } catch (err) {
                      log(colors.red, `[✗] Ошибка компиляции правил: ${err.message}`);
                    }
                  }
                  showMainMenu();
                });
              } else {
                rlNext.close();
                showMainMenu();
              }
            });
          });
        });
        break;
      }
      case '4':
        const rlDS = readline.createInterface({
          input: process.stdin,
          output: process.stdout
        });
        rlDS.question(`\nВведите слаг бренда (например, stripe): `, (slug) => {
          rlDS.close();
          const brandSlug = slug.trim().toLowerCase().replace(/[^a-z0-9]/g, '-');
          if (brandSlug) {
            handleMakeDs(brandSlug);
          } else {
            log(colors.red, '[✗] Слаг бренда не может быть пустым.');
          }
          showMainMenu();
        });
        break;
      case '5':
        handleCompile();
        showMainMenu();
        break;
      case '6':
      case 'exit':
        log(colors.cyan, '\nСпасибо за использование Design Factory! До свидания 👋');
        process.exit(0);
        break;
      default:
        log(colors.red, '\n[✗] Неверный выбор. Пожалуйста, введите цифру от 1 до 6.');
        showMainMenu();
        break;
    }
  });
}

// Main router
const args = rawArgs.filter(arg => arg !== '--silent' && arg !== '-s');
const command = args[0];

if (!command) {
  startWizard();
} else {
  switch (command.toLowerCase()) {
    case 'wizard':
      startWizard();
      break;
    case 'install':
      handleInstall();
      break;
    case 'check':
      handleCheck();
      break;
    case 'extract':
      handleExtract(args[1]);
      break;
    case 'make-ds':
      handleMakeDs(args[1]);
      break;
    case 'compile':
      handleCompile();
      break;
    case 'version':
      console.log(`v${VERSION}`);
      break;
    case 'help':
    default:
      showHelp();
      break;
  }
}

